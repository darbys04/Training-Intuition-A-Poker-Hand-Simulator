One_Pair        = one_pair,
High_Card       = high_card
)
test_results <- sapply(test_cases, hand_value)
hand_score <- function(hand) {
if (nrow(hand) == 5) {
return(list(hand_value(hand), hand))
}
else {
hand_order <- c("High Card", "Pair", "Two Pair", "Three of a Kind",
"Straight", "Flush", "Full House", "Four of a Kind",
"Straight Flush", "Royal Flush")
combs <- combn(nrow(hand), 5)
best_rank <- 0
best_value <- NULL
best_subset <- NULL
for (i in 1:ncol(combs)) {
current_subset <- hand[combs[, i], ]
value <- as.character(hand_value(current_subset))
rank <- match(value, hand_order)
if (rank > best_rank) {
best_rank <- rank
best_value <- value
best_subset <- current_subset
}
}
return(list(best_value, best_subset))
}
}
